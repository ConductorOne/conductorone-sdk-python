# ConductorOne SDK Test Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# Required: Authentication and API endpoint
# ============================================================================
C1_CLIENT_ID=your_client_id_here@your_domain.com/pcc
C1_CLIENT_SECRET=secret-token:conductorone.com:v1:your_secret_here
C1_SERVER_URL=https://your-domain.conductor.one

# ============================================================================
# Common resource identifiers (used by many tests)
# ============================================================================
# App ID used by app-scoped tests (also used as source app ID for proxy tests)
C1_APP_ID=

# Resource type ID under the app
C1_APP_RESOURCE_TYPE_ID=

# Resource ID of an app resource
C1_APP_RESOURCE_ID=

# Entitlement ID within the app
C1_APP_ENTITLEMENT_ID=

# Identity user ID relevant to entitlement/user-binding tests
C1_IDENTITY_USER_ID=

# ============================================================================
# Cross-app proxy tests
# ============================================================================
# Destination app ID (C1_APP_ID is used as the source app ID)
C1_DST_APP_ID=

# Destination app entitlement ID (C1_APP_ENTITLEMENT_ID is used as the source)
C1_DST_APP_ENTITLEMENT_ID=

# ============================================================================
# Optional: Additional test configuration
# ============================================================================
C1_TEST_TIMEOUT=30
C1_TEST_PAGE_SIZE=10

# Policy ID used to configure defaults
C1_REQUEST_POLICY_ID=

# Request catalog ID used to configure defaults
C1_CATALOG_ID=
